{
  "expo": {
    "name": "elliesnote",
    "slug": "elliesnote",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/icon.png",
    "scheme": "elliesnote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cc.elliesnote",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "dark": "./src/assets/icons/ios-dark.png",
        "light": "./src/assets/icons/ios-light.png",
        "tinted": "./src/assets/icons/ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F7F4",
        "foregroundImage": "./src/assets/icons/adaptive-icon.png",
        "monochromeImage": "./src/assets/icons/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "cc.elliesnote"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "organization": "damilola-bada",
          "project": "elliesnote"
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "Elliesnote reads sleep, heart rate, and activity data to help you understand your energy patterns.",
          "healthUpdatePermission": "Elliesnote does not write to Apple Health."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icons/icon.png",
          "color": "#F9F7F4",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icons/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F9F7F4",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./src/assets/icons/splash-icon-light.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9f778dd-0cd1-4f03-8173-8790c89564a7"
      }
    },
    "owner": "damygoes"
  }
}
