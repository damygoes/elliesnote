    "victory-native": "41.20.2"
  },
  "devDependencies": {
    "@clerk/types": "4.101.20",
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "@commitlint/types": "20.5.0",
    "@types/react": "19.1.0",
    "eslint": "9.25.0",
    "eslint-config-expo": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "expo-dev-client": "6.0.21",
    "husky": "9.1.7",
